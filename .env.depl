# Copy to .env on the machine that runs Node. Do not commit .env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reseivedanemail@gmail.com
SMTP_PASS=
SMTP_FROM=BTS Komputer <reseivedanemail@gmail.com>

# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# Dev only: print OTP codes in the API terminal when SMTP is missing or fails.
OTP_LOG_TO_CONSOLE=0

# Bind address. Use 127.0.0.1 if only this PC should reach the API (e.g. Tailscale Serve in front).
HOST=0.0.0.0

# Optional: custom SQLite path (one file per toko).
# DB_PATH=server/data/revits.db

# PORT 3001 IS TESTING ONLY. DO NOT USE IT IN DEPLOYMENT.
# PORT=3001